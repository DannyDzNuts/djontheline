---
interface Props { count: number; placeholder?: boolean; }
const { count, placeholder = false } = Astro.props;
---
<section class="portfolio-intro page-width" id="work" aria-labelledby="work-title" data-reveal>
  <div class="section-label"><span class="eyebrow">Selected work</span><span class="eyebrow">{String(count).padStart(2, '0')} dishes / an ongoing practice</span></div>
  <div class="intro-grid"><h2 id="work-title">Food I’m proud of,<br /><em>and the skills behind it.</em></h2><p>Built on the fundamentals.<br />Refined with every service.<br />A collection of plates<br class="desktop-break" /> and the work behind them.</p></div>
  {placeholder && <p class="photography-note">Placeholder photographs are labeled while I prepare photographs of my own work.</p>}
</section>
