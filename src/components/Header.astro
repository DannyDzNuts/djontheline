---
import { url } from '../lib/paths';
import { profile } from '../data/profile';
interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
---
<header class:list={['site-header', { overlay }]}>
  <a class="wordmark" href={url()} aria-label={`${profile.name} — ${profile.role}, home`}>{profile.name}<span class="wordmark-rule" aria-hidden="true"></span><span>{profile.role}</span></a>
  <nav aria-label="Main navigation">
    <a href={url('#work')}>Work</a>
    <a href={url('#experience')}>Experience</a>
    <a href={url('#about')}>About</a>
    <a href={url('#contact')}>Contact</a>
  </nav>
</header>
