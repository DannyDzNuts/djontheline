---
interface Props { direction?: 'right' | 'down' | 'up-right'; }
const { direction = 'right' } = Astro.props;
---
<svg class:list={['arrow', direction]} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.3" /></svg>
<style>.arrow{flex-shrink:0}.down{transform:rotate(90deg)}.up-right{transform:rotate(-45deg)}</style>
