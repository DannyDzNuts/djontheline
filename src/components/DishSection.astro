---
import { type Dish, slugOf, composition } from '../lib/dishes';
import DishMedia from './DishMedia.astro';
import TechniqueTags from './TechniqueTags.astro';
interface Props { dish: Dish; index: number; total: number; }
const { dish, index, total } = Astro.props;
const layout = composition(dish, index);
---
<article class:list={['dish-section', 'page-width', `layout-${layout}`]} id={slugOf(dish)} data-dish data-reveal aria-labelledby={`title-${slugOf(dish)}`}>
  <div class="dish-visual" data-snap-anchor>
    <DishMedia media={dish.data.heroMedia} sizes={layout === 'wide' || layout === 'immersive' ? '(min-width: 1600px) 1360px, 90vw' : '(min-width: 1600px) 780px, (min-width: 900px) 55vw, 100vw'} />
  </div>
  <div class="dish-copy">
    <p class="dish-index">{String(index).padStart(2, '0')} <span>/ {String(total).padStart(2, '0')}</span><span class="index-line" aria-hidden="true"></span></p>
    <p class="eyebrow dish-category">{[dish.data.season || dish.data.category, dish.data.year].filter(Boolean).join(' / ')}</p>
    <h2 id={`title-${slugOf(dish)}`}>{dish.data.title}</h2>
    <p class="dish-description">{dish.data.shortDescription}</p>
    <TechniqueTags techniques={dish.data.techniques} />
  </div>
  {dish.data.media.length > 0 && <div class="dish-details" aria-label={`${dish.data.title} — more from the plate`}>{dish.data.media.map(media => <DishMedia media={media} sizes="(min-width: 900px) 35vw, 80vw" />)}</div>}
</article>
