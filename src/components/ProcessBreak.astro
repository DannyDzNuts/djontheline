---
import type { Dish } from '../lib/dishes';
import DishMedia from './DishMedia.astro';
import { mediaInfo } from '../lib/media';
import { url } from '../lib/paths';
import Arrow from './Arrow.astro';
interface Props { process: NonNullable<Dish['data']['process']>; id: string; }
const { process, id } = Astro.props;
const { width, height } = mediaInfo(process.media);
const titleId = `${id}-title`;
---
{process.media.type === 'video' ? (
  <section class="process-film" id={id} aria-labelledby={titleId} data-reveal>
    <div class="page-width"><p class="eyebrow">Process / Behind the plate</p><h2 id={titleId}>{process.title}</h2><p>{process.description}</p><DishMedia media={process.media} sizes="90vw" /></div>
  </section>
) : (
  <section class="process-break" id={id} aria-labelledby={titleId} data-reveal>
    <DishMedia media={process.media} class="process-media" sizes={`max(100vw, ${Math.ceil(width / height * 580)}px, ${Math.ceil(width / height * 80)}svh)`} label={false} extras={false} lightbox={false} />
    <div class="process-scrim" aria-hidden="true"></div>
    <div class="process-copy page-width">
      <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> Process / Behind the plate</p>
      <h2 id={titleId}>{process.title}</h2><p>{process.description}</p>
      <span class="process-note">{process.media.placeholder ? 'Process / still placeholder' : 'Process / from the kitchen'}</span>
      <a class="text-link process-enlarge" href={url(process.media.src)} data-lightbox data-alt={process.media.alt}>Enlarge photo <Arrow direction="up-right" /></a>
    </div>
  </section>
)}
