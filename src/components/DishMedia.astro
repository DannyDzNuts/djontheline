---
import type { Media } from '../lib/dishes';
import { url } from '../lib/paths';
import { mediaInfo } from '../lib/media';
interface Props { media: Media; eager?: boolean; sizes?: string; class?: string; label?: boolean; extras?: boolean; lightbox?: boolean; }
const { media, eager = false, sizes = '(min-width: 900px) 60vw, 100vw', class: className, label = true, extras = true, lightbox = true } = Astro.props;
const { prepared, width, height } = mediaInfo(media);
const srcset = (format: 'webp' | 'avif') => prepared?.variants.map(v => `${url(v[format])} ${v.width}w`).join(', ');
const PhotoWrapper = lightbox ? 'a' : 'div';
---
<figure class:list={['dish-media', className]} style={`--media-ratio:${width}/${height};--media-position:${media.position}`}>
  <div class="media-frame">
    {media.type === 'image' ? (
      <PhotoWrapper class={lightbox ? 'media-link' : undefined} href={lightbox ? url(media.src) : undefined} data-lightbox={lightbox || undefined} data-alt={lightbox ? media.alt : undefined} aria-label={lightbox ? `Enlarge photo: ${media.alt}` : undefined}>
      <picture>
        {prepared && <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />}
        <img src={url(media.src)} srcset={srcset('webp')} sizes={sizes} alt={media.alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
      </picture>
      </PhotoWrapper>
    ) : (
      <>
        <video width={width} height={height} poster={url(media.poster)} preload="none" controls muted playsinline loop={media.autoplay} data-video data-autoplay={media.autoplay || undefined} aria-label={media.alt}>
          <source data-src={url(media.src)} />
          {media.captions && <track kind="captions" src={url(media.captions)} srclang="en" label="English" default />}
          Your browser does not support embedded video. Use the video link below.
        </video>
        {extras && <a class="video-fallback" href={url(media.src)}>Open video file <span aria-hidden="true">↗</span></a>}
      </>
    )}
    {media.placeholder && label && <span class="placeholder-label">Photography placeholder</span>}
  </div>
  {extras && media.caption && <figcaption>{media.caption}</figcaption>}
  {extras && media.type === 'video' && media.transcript && <details class="transcript"><summary>Video description / transcript</summary><p>{media.transcript}</p></details>}
</figure>
