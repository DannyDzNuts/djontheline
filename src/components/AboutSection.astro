---
import { profile } from '../data/profile';
---
<section class="about-section page-width" id="about" aria-labelledby="about-title" data-reveal>
  <div class="about-kicker"><span class="eyebrow">The chef behind the work</span><span class="about-monogram" aria-hidden="true">DJ<span>.</span></span></div>
  <div class="about-copy">
    <h2 id="about-title">Good food.<br /><em>Better every day.</em></h2>
    <p>{profile.bio}</p>
    <p>{profile.approach}</p>
  </div>
</section>
