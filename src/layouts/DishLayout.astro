---
import BaseLayout from './BaseLayout.astro';
import DishMedia from '../components/DishMedia.astro';
import TechniqueTags from '../components/TechniqueTags.astro';
import Arrow from '../components/Arrow.astro';
import { type Dish, slugOf } from '../lib/dishes';
import { url } from '../lib/paths';
interface Props { dish: Dish; next?: Dish; }
const { dish, next } = Astro.props;
const data = dish.data;
---
<BaseLayout title={`${data.title} — Dish Study | DJ — Cook`} description={data.shortDescription} image={data.heroMedia.type === 'image' ? data.heroMedia.src : data.heroMedia.poster}>
  <article class="dish-study">
    <header class="study-header page-width">
      <a class="back-link" href={url(dish.data.featured ? `#${slugOf(dish)}` : '#work')}>← Back to selected work</a>
      <div class="section-label"><p class="eyebrow">Dish study / {data.category}</p>{data.season && <p class="eyebrow">{data.season}</p>}</div>
      <h1>{data.title}</h1><p class="study-description">{data.shortDescription}</p><TechniqueTags techniques={data.techniques} />
      {data.sample && <p class="sample-note">Sample dish study — photography and notes are illustrative, pending my own documented work.</p>}
    </header>
    <div class="study-hero page-width"><DishMedia media={data.heroMedia} eager sizes="(min-width: 1600px) 1360px, 90vw" /></div>
    {(data.notes || data.whatWorked || data.nextIteration) && <section class="study-notes page-width" aria-label="Technique and reflection">
      {data.notes && <div class="study-intent"><h2 class="eyebrow">The focus</h2><p>{data.notes}</p></div>}
      <div class="study-reflections">{data.whatWorked && <div><h2 class="eyebrow">What worked</h2><p>{data.whatWorked}</p></div>}{data.nextIteration && <div><h2 class="eyebrow">Next iteration</h2><p>{data.nextIteration}</p></div>}</div>
    </section>}
    {data.media.length > 0 && <section class="study-gallery page-width" aria-label="Additional photography and process">{data.media.map(media => <DishMedia media={media} sizes="(min-width: 1200px) 1000px, 90vw" />)}</section>}
    <div class="study-body page-width"><slot /></div>
    {data.process && <section class="study-process page-width" aria-label="Process study"><h2>{data.process.title}</h2><p>{data.process.description}</p><DishMedia media={data.process.media} sizes="90vw" /></section>}
  </article>
  <nav class="study-next page-width" aria-label="More work"><a class="text-link" href={url('#work')}>All selected work <Arrow /></a>{next && <a href={url(`dishes/${slugOf(next)}/`)}><span class="eyebrow">Next dish study</span><span class="next-title">{next.data.title} <Arrow /></span></a>}</nav>
</BaseLayout>
