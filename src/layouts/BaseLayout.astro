---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/newsreader';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionDebug from '../components/MotionDebug.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import { url } from '../lib/paths';
interface Props { title?: string; description?: string; overlay?: boolean; image?: string; }
const { title = 'DJ — Chef | Culinary Portfolio', description = 'Chef DJ’s selected work. A strong grill background, thoughtful execution, and a steadily expanding range.', overlay = false, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#F4F2EC" />
    <title>{title}</title><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(url(image), Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.motion = 'pending';
        setTimeout(() => {
          if (document.documentElement.dataset.motion === 'pending') delete document.documentElement.dataset.motion;
        }, 4000);
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer /><PhotoLightbox /><MotionDebug />
    <script>
      import { initMotion } from '../scripts/scroll-motion';
      import { initMobileSettle } from '../scripts/mobile-settle';
      import { initVideo } from '../scripts/video';
      import { initWheelMotion } from '../scripts/wheel-motion';
      import { initLightbox } from '../scripts/lightbox';
      initMotion(); initMobileSettle(); initWheelMotion(); initVideo(); initLightbox();
    </script>
  </body>
</html>
