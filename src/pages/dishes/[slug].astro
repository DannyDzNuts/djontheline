---
import { render } from 'astro:content';
import DishLayout from '../../layouts/DishLayout.astro';
import { portfolio, slugOf, type Dish } from '../../lib/dishes';
export async function getStaticPaths() {
  const { all } = await portfolio();
  const studies = all.filter(d => d.data.study);
  return studies.map((dish, index) => ({ params: { slug: slugOf(dish) }, props: { dish, next: studies.length > 1 ? studies[(index + 1) % studies.length] : undefined } }));
}
interface Props { dish: Dish; next?: Dish; }
const { dish, next } = Astro.props;
const { Content } = await render(dish);
---
<DishLayout dish={dish} next={next}><Content /></DishLayout>
